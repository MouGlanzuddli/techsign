<?xml version="1.0" encoding="UTF-8"?>
<project name="TechSign" default="default" basedir=".">
    <description>Builds, tests, and runs the project TechSign.</description>
    <import file="nbproject/build-impl.xml"/>

    <property name="custom.dist.dir" location="custom_dist"/>
    <property name="custom.web.app.name" value="TechSign_Custom"/>

    <target name="-post-dist">
        <echo message="NetBeans 'dist' target finished. Now performing custom post-dist actions."/>
        
        <echo message="Copying WAR from ${dist.war} to ${custom.dist.dir}/"/>
        <mkdir dir="${custom.dist.dir}"/>
        <copy file="${dist.war}" todir="${custom.dist.dir}"/>
        <echo message="WAR copied to ${custom.dist.dir}/"/>

        </target>

    <target name="build-custom-war" depends="clean-custom-war, -do-ear-init" description="Builds a custom WAR file.">
        <echo message="Building custom WAR: ${custom.web.app.name}.war"/>
        
        <war destfile="${custom.dist.dir}/${custom.web.app.name}.war"
             webxml="${build.web.inf.dir}/web.xml">
            
            <fileset dir="${web.docbase.dir}">
                <include name="**/*"/>
                <exclude name="WEB-INF/web.xml"/> <exclude name="WEB-INF/classes/**"/> <exclude name="WEB-INF/lib/**"/> </fileset>
            
            <classes dir="${build.web.classes.dir}"/>
            
            <lib dir="${build.web.inf.dir}/lib"/>
            
            </war>
        <echo message="Custom WAR created at ${custom.dist.dir}/${custom.web.app.name}.war"/>
    </target>

    <target name="clean-custom-war" description="Cleans the custom WAR build artifacts.">
        <delete dir="${custom.dist.dir}"/>
    </target>
    
    </project>